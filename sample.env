# Copy to `.env.local` to configure locally. On Vercel, set these under
# Settings -> Environment Variables.

# Supabase project (Project Settings -> API). The publishable key is safe to expose;
# never put a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Google Analytics 4 measurement ID. Analytics are only loaded when this is set.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Supabase secret key (Project Settings -> API Keys -> Secret keys). SERVER-ONLY:
# it bypasses row-level security, and is used only for adding/deleting users.
# Never commit it or give it a NEXT_PUBLIC_ prefix. In Vercel, mark it Sensitive.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
